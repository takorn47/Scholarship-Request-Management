# Copy this file to .env in the repo root before running `docker compose up`.

# --- Postgres ---
POSTGRES_DB=scholarshipDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend (SRMBackend) ---
BACKEND_PORT=8080
JWT_ISSUER=https://localhost:5001
JWT_AUDIENCE=https://localhost:5001
JWT_KEY=change-me-to-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (SRMFrontend) ---
FRONTEND_PORT=3000
# Must point to how the browser reaches the backend (not the internal "backend" hostname).
VITE_API_URL=http://localhost:8080
